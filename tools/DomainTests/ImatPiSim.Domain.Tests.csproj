<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Ejecuta con `dotnet test tools/DomainTests` los MISMOS tests NUnit que el Test Runner
    de Unity (Assets/Tests/EditMode). Se usa NUnit 3, la serie que trae Unity, para que
    ambos entornos admitan la misma API.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\Assets\Tests\EditMode\**\*.cs" LinkBase="Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="Domain\ImatPiSim.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
  </ItemGroup>

</Project>
